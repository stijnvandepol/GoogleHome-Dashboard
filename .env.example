# Kopieer dit bestand naar .env en vul de waarden in.
# .env staat in .gitignore en wordt NIET gecommit — hier horen geen echte
# secrets in, alleen lege placeholders.

# --- Weer (KNMI EDR API) ---
# Het dashboard haalt de buitentemperatuur op bij KNMI. Dit VEREIST een
# (gratis) API-key: https://developer.dataplatform.knmi.nl/
# nginx injecteert deze key server-side in de Authorization-header van de
# /knmi-proxy. Is de key leeg of verlopen, dan blijft de temperatuur op de
# laatst bekende waarde hangen.
KNMI_API_KEY=

# --- Camera (live snapshot op knopdruk) ---
# Volledige snapshot-URL van de camera (LAN-adres):
CAMERA_SNAPSHOT_URL=http://192.168.1.17/images/snapshot.jpg
# Inloggegevens van de camera (Digest-auth, blijven server-side):
CAMERA_USER=
CAMERA_PASS=
# Optioneel: poort en timeout van de camera-proxy sidecar.
# CAMERA_PROXY_PORT=8088
# CAMERA_TIMEOUT=8
