# Kopieer dit bestand naar .env en vul de waarden in (.env staat in .gitignore).

# KNMI EDR API key (https://developer.dataplatform.knmi.nl/)
KNMI_API_KEY=

# Camera (live snapshot op knopdruk)
# Volledige snapshot-URL van de camera:
CAMERA_SNAPSHOT_URL=http://192.168.1.17/images/snapshot.jpg
# Inloggegevens van de camera:
CAMERA_USER=
CAMERA_PASS=
